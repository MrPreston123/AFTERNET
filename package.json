{
  "name": "afternet",
  "version": "1.1.1",
  "private": true,
  "license": "MIT",
  "description": "AFTERNET: an offline survival system. Offline Wikipedia, survival library, local AI and offline GPS.",
  "scripts": {
    "dev": "next dev -p 3500",
    "prebuild": "node scripts/land-dots.mjs && node scripts/icons.mjs && node scripts/copy-wasm.mjs",
    "predev": "node scripts/copy-wasm.mjs",
    "packs": "node scripts/wiki-pack.mjs --force",
    "build": "next build && node scripts/sw-manifest.mjs",
    "serve": "npx --yes serve@14.2.4 out -l 3501",
    "app:win": "npm run build && electron-builder --win nsis --publish never",
    "app:run": "electron .",
    "app:android": "npm run build && node scripts/native-entry.mjs && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "@react-three/postprocessing": "^3.0.4",
    "@wllama/wllama": "^3.13.0",
    "gsap": "3.13.0",
    "lenis": "1.3.11",
    "maplibre-gl": "5.9.0",
    "next": "15.5.29",
    "qrcode": "^1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@types/node": "22.18.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/three": "^0.180.0",
    "d3-geo": "3.1.1",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "node-html-parser": "^7.0.1",
    "sharp": "0.34.4",
    "topojson-client": "3.1.0",
    "typescript": "5.9.2",
    "world-atlas": "2.0.2"
  },
  "main": "electron/main.cjs",
  "author": "AFTERNET",
  "homepage": "https://github.com/MrPreston123/AFTERNET",
  "build": {
    "appId": "app.afternet.offline",
    "productName": "AFTERNET",
    "copyright": "MIT · AFTERNET contributors",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**",
      "out/**",
      "package.json",
      "!node_modules/**/*",
      "!out/brand/logo-source.png",
      "!out/brand/banner.png"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "artifactName": "AFTERNET-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AFTERNET",
      "deleteAppDataOnUninstall": false
    },
    "npmRebuild": false,
    "compression": "maximum"
  }
}
